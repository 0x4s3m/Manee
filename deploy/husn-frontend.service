[Unit]
Description=Husn (حصن) — React dashboard (static)
After=network-online.target husn-backend.service

[Service]
Type=simple
User=husn
Group=husn
WorkingDirectory=/opt/husn/frontend
# Serve the built dist/ on :5173. We use `npx serve` with a fallback to
# python's http.server so this works even on minimal images.
ExecStart=/bin/sh -c 'npx --yes serve -s dist -l 5173 || python3 -m http.server 5173 --directory dist'
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
